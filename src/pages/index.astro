---
import Layout from '../layouts/Layout.astro';
const services = [
  ['Software development', 'Design and development of web, mobile and business software around the way organisations work.'],
  ['IT consulting', 'Technical planning, software architecture and clear guidance for technology decisions.'],
  ['Hardware integration', 'Connecting hardware and technology infrastructure with the systems that need them.'],
  ['Digital solutions', 'Practical digital systems designed around organisational and operational requirements.'],
];
---
<Layout title="Vertabyte — Technology built for real operations" description="Vertabyte Tech Limited develops practical software and digital systems for businesses and organisations. Software development, IT consulting and hardware integration.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <p class="eyebrow light"><span class="small-line" aria-hidden="true"></span> VERTABYTE TECH LIMITED</p>
      <h1 id="hero-title">Technology built<br />for <em>real operations.</em></h1>
      <div class="hero-bottom">
        <div><p class="hero-copy">We develop software and digital systems around real organisational needs. Thoughtfully designed to support the work that matters.</p><div class="actions"><a class="button" href="mailto:info@vertabyte.tech">Contact us</a><a class="text-link" href="#services">What we do <span aria-hidden="true">↓</span></a></div></div>
        <p class="hero-note">Practical thinking.<br />Purposeful technology.</p>
      </div>
      <div class="hero-rule"><span>SOFTWARE & DIGITAL SYSTEMS</span><span aria-hidden="true">01 — VERTABYTE</span></div>
    </div>
  </section>
  <section id="about" class="section container split" aria-labelledby="about-title">
    <p class="eyebrow">01 / ABOUT VERTABYTE</p>
    <div><h2 id="about-title">A practical approach<br />to technology.</h2><p class="lead">Vertabyte Tech Limited is a private limited technology company focused on developing software and digital systems for businesses and organisations.</p><p class="body-copy">Our work spans software development, IT consulting, hardware integration and digital solutions. Our software products support business and education, with a focus on everyday operational needs.</p></div>
  </section>
  <section id="services" class="services section" aria-labelledby="services-title">
    <div class="container"><div class="section-heading"><div><p class="eyebrow">02 / WHAT WE DO</p><h2 id="services-title">From planning<br />to implementation.</h2></div><p>Clear thinking and practical engineering,<br class="desktop-break" /> across four connected areas.</p></div>
    <div class="service-grid">{services.map(([title, description], i) => <article class="service"><span class="service-number">0{i+1}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div>
  </section>
  <section id="build" class="section container" aria-labelledby="build-title">
    <div class="section-heading"><div><p class="eyebrow">03 / WHAT WE BUILD</p><h2 id="build-title">Software for everyday work.</h2></div></div>
    <article class="product">
      <div class="product-intro">
        <h3>School management<br />software</h3>
        <p>A modern school-management platform that brings administration, academics, communication and family access into one system.</p>
        <a class="inline-link" href="mailto:info@vertabyte.tech?subject=School%20management%20software%20enquiry">Enquire about this product <span aria-hidden="true">↗</span></a>
      </div>
      <div class="product-areas">
        <p class="eyebrow">DESIGNED AROUND SCHOOL OPERATIONS</p>
        <ul>
          <li>Student and parent management</li>
          <li>Teachers, classes and attendance</li>
          <li>Homework, communication and notifications</li>
          <li>Academic results and report cards</li>
          <li>Fees and student accounts</li>
          <li>Parent and student access</li>
        </ul>
      </div>
    </article>
    <article class="product">
      <div class="product-intro">
        <h3>Computer-Based Testing</h3>
        <p>Digital assessment and examination technology for organisations that need a reliable way to administer computer-based tests.</p>
        <a class="inline-link" href="mailto:info@vertabyte.tech?subject=Computer-Based%20Testing%20enquiry">Enquire about this solution <span aria-hidden="true">↗</span></a>
      </div>
      <div class="product-areas">
        <p class="eyebrow">COMPUTER-BASED TESTING (CBT)</p>
        <ul>
          <li>Computer-based examinations</li>
          <li>Digital assessments</li>
          <li>Support for CBT environments</li>
        </ul>
      </div>
    </article>
  </section>
  <section class="principles section container split" aria-labelledby="principles-title"><div><p class="eyebrow">04 / HOW WE WORK</p><h2 id="principles-title">Built with<br />care and purpose.</h2></div><div class="principle-list"><article><h3>Start with the real workflow</h3><p>Understand the people, processes and requirements before deciding what to build.</p></article><article><h3>Keep systems maintainable</h3><p>Favour clear, manageable solutions that can be understood and improved over time.</p></article><article><h3>Engineer responsibly</h3><p>Consider security and reliability throughout design and development.</p></article></div></section>
  <section id="contact" class="contact" aria-labelledby="contact-title"><div class="container contact-inner"><div><p class="eyebrow light">05 / GET IN TOUCH</p><h2 id="contact-title">Let’s talk about<br />what you need.</h2><p>For project enquiries, company information<br class="desktop-break" /> or questions about our software.</p></div><div class="contact-details"><a href="mailto:info@vertabyte.tech">info@vertabyte.tech <span aria-hidden="true">↗</span></a><p>Already using our software? <a href="/support">Visit support</a></p></div></div></section>
</Layout>
